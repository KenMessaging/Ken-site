{
  "name": "ken-donations",
  "main": "donations.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "donations.kenmessaging.app", "custom_domain": true }
  ],
  "ratelimits": [
    { "name": "CLAIM_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ken-public-donations",
      "database_id": "9f8b0ea4-5502-4c67-b65b-04b0e4ca03ab"
    }
  ]
}
